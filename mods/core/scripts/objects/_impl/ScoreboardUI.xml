<Defaults>
    <Button fontSize="72" textColor="#f8f8f8" colors="#353839|#424546|#353839|#f8f8f8fa" fontStyle="Bold" outline="White" outlineSize="1"/>
    <HorizontalLayout/>
</Defaults>

<VerticalLayout position="0 0 -100" width="2000" height="1650" scale="0.3 0.3 0.3" spacing="8">
    <HorizontalLayout>
        <Button ignoreLayout="true" rectAlignment="LowerLeft" Width="700" height="180"
        id="redInitiativeButton" onClick="setInitiative(Red)" textColor="Red" preferredWidth="105" fontSize="110">
            Red
        </Button>
        <Button ignoreLayout="true" rectAlignment="LowerCenter" Width="584" height="180"
        interactible="false" colors="#353839|#353839|#353839" fontSize="100">
            Initiative
        </Button>
        <Button ignoreLayout="true" rectAlignment="LowerRight" Width="700" height="180"
        id="blueInitiativeButton" onClick="setInitiative(Blue)" textColor="Blue" fontSize="110">
            Blue
        </Button>
    </HorizontalLayout>
    <Button id="roundButton" onClick="toggleRound" fontSize="120">Round 1</Button>
    <Button id="availableSupplyButton" onClick="toggleAvailableSupply" fontSize="100" preferredHeight="50">Available Supply 6</Button>    
    <HorizontalLayout>
        <Button ignoreLayout="true" rectAlignment="UpperLeft" Width="996" height="185"
        id="redSupply" onClick="toggleRedSupply">Red Supply 0</Button>
        <Button ignoreLayout="true" rectAlignment="UpperRight" Width="996" height="185"
        id="blueSupply" onClick="toggleBlueSupply">Blue Supply 0</Button>
    </HorizontalLayout>
    <HorizontalLayout>
        <Button ignoreLayout="true" rectAlignment="UpperLeft" Width="996" height="185" offsetXY="0 35"
         id="redSupplyDestroyed" onClick="toggleRedSupplyDestroyed">Red Supply Destroyed 0</Button> 
        <Button ignoreLayout="true" rectAlignment="UpperRight" Width="996" height="185" offsetXY="0 35"
         id="blueSupplyDestroyed" onClick="toggleBlueSupplyDestroyed">Blue Supply Destroyed 0</Button>
    </HorizontalLayout>
    <HorizontalLayout>
        <Button ignoreLayout="true" rectAlignment="UpperLeft" Width="996" height="185" offsetXY="0 70"
         id="redMissionVP" onClick="toggleRedMissionVP">Red Mission VP 0</Button>
        <Button ignoreLayout="true" rectAlignment="UpperRight" Width="996" height="185" offsetXY="0 70"
         id="blueMissionVP" onClick="toggleBlueMissionVP">Blue Mission VP 0</Button>
    </HorizontalLayout>
    <HorizontalLayout>
        <Button ignoreLayout="true" rectAlignment="UpperLeft" Width="320" height="290" offsetXY="375 97" fontSize="250"
        id="redTotal" colors="#353839|#353839|#353839">0</Button>
        <Button ignoreLayout="true" rectAlignment="UpperRight" Width="320" height="290" offsetXY="-375 97" fontSize="250"
        id="blueTotal" colors="#353839|#353839|#353839">0</Button>
    </HorizontalLayout>
</VerticalLayout>