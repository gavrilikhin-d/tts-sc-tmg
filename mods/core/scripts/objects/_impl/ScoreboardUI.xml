<Defaults>
    <Button fontSize="72" textColor="#f8f8f8" colors="#353839|#424546|#353839|#f8f8f8fa" fontStyle="Bold" outline="White" outlineSize="1"/>
    <HorizontalLayout preferredHeight="185" spacing="8" />
</Defaults>

<!-- Scaling down for highres fonts -->
<VerticalLayout position="0 0 -100" width="2000" height="1650" scale="0.3 0.3 0.3" spacing="8">
    <HorizontalLayout preferredHeight="180">
        <Button id="redInitiativeButton" onClick="setInitiative(Red)" preferredWidth="700" textColor="Red" fontSize="110">
            Red
        </Button>
        <Button preferredWidth="584" interactible="false" colors="#353839|#353839|#353839" fontSize="100">
            Initiative
        </Button>
        <Button  id="blueInitiativeButton" onClick="setInitiative(Blue)" preferredWidth="700" textColor="Blue" fontSize="110">
            Blue
        </Button>
    </HorizontalLayout>
    <Button id="roundButton" onClick="toggleRound" preferredHeight="185" fontSize="120">Round 1</Button>
    <!-- "&#xA;" is a new line character -->
    <Button id="availableSupplyButton" onClick="toggleAvailableSupply" preferredHeight="300" fontSize="100">Available Supply&#xA;0</Button>    
    <HorizontalLayout>
        <Button id="redSupply" onClick="toggleRedSupply">Red Supply 0</Button>
        <Button id="blueSupply" onClick="toggleBlueSupply">Blue Supply 0</Button>
    </HorizontalLayout>
    <HorizontalLayout>
        <Button id="redSupplyDestroyed" onClick="toggleRedSupplyDestroyed">Red Supply Destroyed 0</Button> 
        <Button id="blueSupplyDestroyed" onClick="toggleBlueSupplyDestroyed">Blue Supply Destroyed 0</Button>
    </HorizontalLayout>
    <HorizontalLayout>
        <Button id="redMissionVP" onClick="toggleRedMissionVP">Red Mission VP 0</Button>
        <Button id="blueMissionVP" onClick="toggleBlueMissionVP">Blue Mission VP 0</Button>
    </HorizontalLayout>
    <HorizontalLayout preferredHeight="290" spacing="680" childAlignment="MiddleCenter" childForceExpandWidth="false">
        <Button id="redTotal" preferredWidth="320" fontSize="250" colors="#353839|#353839|#353839">0</Button>
        <Button id="blueTotal" preferredWidth="320" fontSize="250" colors="#353839|#353839|#353839">0</Button>
    </HorizontalLayout>
</VerticalLayout>